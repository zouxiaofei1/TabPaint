<Window x:Class="TabPaint.UIHandlers.TabDragGhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TabDragGhostWindow"
        Width="140"
        Height="84"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Border Margin="6"
            Padding="8"
            CornerRadius="8"
            Background="{DynamicResource GlassBackgroundMediumBrush}"
            BorderBrush="{DynamicResource ListItemSelectedBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True"
            Opacity="0.96">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.28" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image x:Name="GhostImage"
                   Grid.Row="0"
                   Width="100"
                   Height="60"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            <TextBlock x:Name="GhostTitle"
                       Grid.Row="1"
                       Margin="0,4,0,0"
                       FontSize="12"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Grid>
    </Border>
</Window>
