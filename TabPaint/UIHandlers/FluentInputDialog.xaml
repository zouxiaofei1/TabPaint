<Window x:Class="TabPaint.UIHandlers.FluentInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TabPaint" 
        Height="Auto" Width="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/SubWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource GlassBackgroundMediumBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            Name="RootBorder"
            CornerRadius="8"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtTitle" 
                       Grid.Row="0"
                       Text="Title" 
                       Margin="24,16,24,0"
                       FontWeight="SemiBold" 
                       FontSize="13" 
                       Opacity="0.8"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Grid.Column="0"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="BtnCancel_Click"  HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
            <StackPanel Grid.Row="1" Margin="24,16,24,24">
                <TextBlock x:Name="TxtMessage" 
                           Text="Message Content" 
                           TextWrapping="Wrap" 
                           FontSize="14" 
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputTextBox" 
                             Height="32" 
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             FontSize="14"
                             KeyDown="InputTextBox_KeyDown"
                             Style="{DynamicResource FluentTextBoxStyle}"/>
                    <ComboBox x:Name="SuffixComboBox"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               MinWidth="80"
                               Style="{DynamicResource FluentComboBoxStyle}"
                               Visibility="Collapsed"/>
                </Grid>

            </StackPanel>
            <Border Grid.Row="2" 
                    Background="{DynamicResource SubtleHoverBrush}" 
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    Name="SecondBorder"
                    CornerRadius="0,0,8,8"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOk" Content="{DynamicResource L_Common_OK}" Style="{DynamicResource Win11PrimaryButtonStyle}" MinWidth="76" Height="32" Margin="8,0,0,0" Click="BtnOk_Click" />
                    <Button x:Name="BtnCancel" Content="{DynamicResource L_Common_Cancel}" Style="{DynamicResource Win11SecondaryButtonStyle}" MinWidth="76" Height="32" Margin="8,0,0,0" Click="BtnCancel_Click" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
