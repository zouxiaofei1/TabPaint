<UserControl x:Class="TabPaint.Pages.SystemReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="500"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/SubWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <StackPanel Margin="24,24,44,24">
        <TextBlock Text="{DynamicResource L_Settings_Advanced_CollectReport_Title}"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Text="{DynamicResource L_Settings_Advanced_CollectReport_Desc}"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   TextWrapping="Wrap"/>

        <Border Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,10">
            <TextBox x:Name="ReportTextBox"
                     MinHeight="280"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="12"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="{DynamicResource L_Settings_Advanced_CollectReport_Tip}"/>


            <Button DockPanel.Dock="Right" Width="120" Height="32"
                    Content="{DynamicResource L_Settings_Advanced_CollectReport_Copy}"
                    Click="Copy_Click"
                    Style="{StaticResource Win11SecondaryButtonStyle}"/>
        </DockPanel>
    </StackPanel>
</UserControl>