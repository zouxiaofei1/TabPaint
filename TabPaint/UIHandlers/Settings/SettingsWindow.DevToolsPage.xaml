<UserControl x:Class="TabPaint.Pages.DevToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TabPaint"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/SubWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,24,44,24" ContextMenuOpening="Grid_ContextMenuOpening" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu x:Name="PageContextMenu" Style="{StaticResource Win11ContextMenuStyle}">
                <MenuItem x:Name="MenuPin" Click="MenuPin_Click" Style="{StaticResource Win11MenuItemStyle}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PinIcon" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.8,14L10,12.8V4H14V12.8L15.2,14H8.8Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                            <TextBlock x:Name="TxtPin" Text="{DynamicResource L_Settings_PinPage}"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Pin Button -->
        <ToggleButton x:Name="BtnPinTop" 
                      Style="{StaticResource FluentToggleButtonStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" 
                      Margin="0,0,-20,0"
                      Width="32" Height="32"
                      Panel.ZIndex="10"
                      Click="MenuPin_Click"
                      ToolTip="{DynamicResource L_Settings_PinPage}">
            <Path x:Name="PinIconTop" 
                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.8,14L10,12.8V4H14V12.8L15.2,14H8.8Z" 
                  Fill="{DynamicResource IconFillBrush}" 
                  Width="14" Height="14" Stretch="Uniform"/>
        </ToggleButton>


        <TextBlock Grid.Row="0" Text="{DynamicResource L_Settings_DevTools_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" Foreground="{DynamicResource TextPrimaryBrush}"/>
   
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="{DynamicResource L_Settings_Advanced_OpenCache_Title}" Width="120" Height="32" 
                    HorizontalAlignment="Left" Click="OpenCacheFolder_Click"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    BorderThickness="1"/>

            <TextBlock Grid.Column="1" Text="{DynamicResource L_Settings_Advanced_OpenCache_Desc}" 
                       VerticalAlignment="Center" Margin="15,0,0,0" 
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="{DynamicResource L_Settings_Advanced_CollectReport_Title}" Width="120" Height="32"
                    HorizontalAlignment="Left" Click="CollectSystemReport_Click"
                    Style="{StaticResource Win11SecondaryButtonStyle}"
                    BorderThickness="1"/>

            <TextBlock Grid.Column="1" Text="{DynamicResource L_Settings_Advanced_CollectReport_Desc}"
                       VerticalAlignment="Center" Margin="15,0,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,10">
            <TextBlock Text="{DynamicResource L_Exif_Meter_Other}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_Settings_DevTools_UseWin10StyleOnWin11_Title}"/>
                    <TextBlock Text="{DynamicResource L_Settings_DevTools_UseWin10StyleOnWin11_Desc}" 
                Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <CheckBox  Grid.Column="2" x:Name="UseWin10StyleCheckBox" 
                    
                      IsChecked="{Binding UseWin10StyleOnWin11}" 
                      Style="{StaticResource FluentCheckBoxStyle}" 
                      Margin="0,0,0,10"
                      Visibility="Collapsed"/>
            </Grid>

            <!-- 动画时长倍数 -->
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_Settings_DevTools_AnimationSpeed_Title}"/>
                    <TextBlock Text="{DynamicResource L_Settings_DevTools_AnimationSpeed_Desc}" 
                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Slider Grid.Column="1" Margin="10,0,10,0" Style="{StaticResource Win11HorizontalSliderStyle}"
                        Minimum="0" Maximum="4" SmallChange="0.1" LargeChange="0.5"
                        VerticalAlignment="Center"
                        Value="{Binding Path=Current.AnimationSpeedMultiplier, Mode=TwoWay, Source={x:Static local:SettingsManager.Instance}}"/>
                <TextBox Grid.Column="2" 
                         Text="{Binding Path=Current.AnimationSpeedMultiplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.0}, Source={x:Static local:SettingsManager.Instance}}"
                         LostFocus="TextBox_LostFocus"
                         PreviewTextInput="NumberValidationTextBox"
                         HorizontalContentAlignment="Right" 
                         VerticalAlignment="Center"
                         Height="24" Padding="0,2,4,0"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <!-- MD5 / SHA256 Hash Zone -->
            <Border Height="50"
                    Background="{DynamicResource GlassBackgroundLowBrush}" 
                    CornerRadius="8" 
                    AllowDrop="True"
                    Drop="HashDropZone_Drop"
                    DragOver="HashDropZone_DragOver"
                    MouseLeftButtonDown="HashDropZone_MouseLeftButtonDown"
                    Cursor="Hand"
                    Margin="0,0,0,15">
                <Grid>
                    <Rectangle RadiusX="8" RadiusY="8"
                               Stroke="{DynamicResource BorderBrush}" 
                               StrokeThickness="2"
                               StrokeDashArray="4 2"/>
                    <StackPanel x:Name="DropHintPanel" Orientation="Horizontal" 
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{DynamicResource Import_Image}" 
                              Fill="{DynamicResource TextTertiaryBrush}" 
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource L_DevTools_DropHint}" 
                                   Foreground="{DynamicResource TextTertiaryBrush}" 
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- QR Code Recognition Zone -->
              <Border Height="50"
                    Background="{DynamicResource GlassBackgroundLowBrush}" 
                    CornerRadius="8" 
                    AllowDrop="True"
                    Drop="QrCodeDropZone_Drop"
                    DragOver="HashDropZone_DragOver"
                    MouseLeftButtonDown="QrCodeDropZone_MouseLeftButtonDown"
                    Cursor="Hand">
                <Grid>
                    <Rectangle RadiusX="8" RadiusY="8"
                               Stroke="{DynamicResource BorderBrush}" 
                               StrokeThickness="2"
                               StrokeDashArray="4 2"/>
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{DynamicResource QR_Code}" 
                              Fill="{DynamicResource TextTertiaryBrush}" 
                              Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource L_DevTools_QrCode_DropHint}" 
                                   Foreground="{DynamicResource TextTertiaryBrush}" 
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

         <Grid x:Name="HashResultPanel" Grid.Row="5" Margin="0,10,0,0" MaxHeight="100" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
          
        </Grid>
    </Grid>
</UserControl>
