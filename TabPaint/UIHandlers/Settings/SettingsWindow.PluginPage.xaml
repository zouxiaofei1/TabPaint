<UserControl x:Class="TabPaint.Pages.PluginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TabPaint"
             xmlns:controls="clr-namespace:TabPaint.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/SubWindowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PluginCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource GlassBackgroundLowBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="PluginQuickActionTextButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.65"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ContextMenuOpening="Grid_ContextMenuOpening" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu x:Name="PageContextMenu" Style="{StaticResource Win11ContextMenuStyle}">
                <MenuItem x:Name="MenuPin" Click="MenuPin_Click" Style="{StaticResource Win11MenuItemStyle}">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PinIcon" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.8,14L10,12.8V4H14V12.8L15.2,14H8.8Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"/>
                            <TextBlock x:Name="TxtPin" Text="{DynamicResource L_Settings_PinPage}"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Pin Button -->
        <ToggleButton x:Name="BtnPinTop" 
                      Style="{StaticResource FluentToggleButtonStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" 
                      Margin="0,20,20,0"
                      Width="32" Height="32"
                      Panel.ZIndex="10"
                      Click="MenuPin_Click"
                      ToolTip="{DynamicResource L_Settings_PinPage}">
            <Path x:Name="PinIconTop" 
                  Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M8.8,14L10,12.8V4H14V12.8L15.2,14H8.8Z" 
                  Fill="{DynamicResource IconFillBrush}" 
                  Width="14" Height="14" Stretch="Uniform"/>
        </ToggleButton>

        <ScrollViewer x:Name="PluginScrollViewer"
                      Style="{StaticResource FluentScrollViewer}"
                      PreviewMouseWheel="PluginScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="24,24,44,24">
                <TextBlock Text="{DynamicResource L_Settings_Plugins_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L_Settings_Plugins_Desc}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,12,0"/>
                    <Button x:Name="BtnInstallAllPlugins"
                            Grid.Column="1"
                            Click="InstallAllPlugins_Click"
                            Style="{StaticResource PluginQuickActionTextButtonStyle}"
                            VerticalAlignment="Top"/>
                </Grid>

                <!-- RMBG 1.4 -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_RMBG_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_RMBG_Desc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                          

                            <TextBlock x:Name="TxtStatusRMBG" Text="Checking..." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            
                            <Button x:Name="BtnInstallRMBG" Content="{DynamicResource L_Settings_Plugins_InstallReal}" Click="InstallRMBG_Click" Style="{StaticResource Win11PrimaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninstallRMBG" Content="{DynamicResource L_Settings_Plugins_Uninstall}" Click="UninstallRMBG_Click" Style="{StaticResource Win11SecondaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- 内嵌进度条 -->
                        <controls:TaskProgressFloat x:Name="FloatRMBG" IsDraggable="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Real-ESRGAN -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_SR_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_SR_Desc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStatusSR" Text="Checking..." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnInstallSR" Content="{DynamicResource L_Settings_Plugins_InstallReal}" Click="InstallSR_Click" Style="{StaticResource Win11PrimaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninstallSR" Content="{DynamicResource L_Settings_Plugins_Uninstall}" Click="UninstallSR_Click" Style="{StaticResource Win11SecondaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                        </StackPanel>
                        <controls:TaskProgressFloat x:Name="FloatSR" IsDraggable="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- LaMa -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_Inpaint_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_Inpaint_Desc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStatusInpaint" Text="Checking..." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnInstallInpaint" Content="{DynamicResource L_Settings_Plugins_InstallReal}" Click="InstallInpaint_Click" Style="{StaticResource Win11PrimaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninstallInpaint" Content="{DynamicResource L_Settings_Plugins_Uninstall}" Click="UninstallInpaint_Click" Style="{StaticResource Win11SecondaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                        </StackPanel>
                        <controls:TaskProgressFloat x:Name="FloatInpaint" IsDraggable="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- AI OCR Runtime (PaddleOCR) -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_OCR_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_Model_OCR_Desc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStatusOcrRuntime" Text="Checking..." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnInstallOcrRuntime" Content="{DynamicResource L_Settings_Plugins_InstallReal}" Click="InstallOcrRuntime_Click" Style="{StaticResource Win11PrimaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninstallOcrRuntime" Content="{DynamicResource L_Settings_Plugins_Uninstall}" Click="UninstallOcrRuntime_Click" Style="{StaticResource Win11SecondaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                        </StackPanel>
                        <controls:TaskProgressFloat x:Name="FloatOcrRuntime" IsDraggable="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- QR Code Recognition (ZXing.Net) -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_ZXing_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_ZXing_Desc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStatusZXing" Text="Checking..." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnInstallZXing" Content="{DynamicResource L_Settings_Plugins_InstallReal}" Click="InstallZXing_Click" Style="{StaticResource Win11PrimaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninstallZXing" Content="{DynamicResource L_Settings_Plugins_Uninstall}" Click="UninstallZXing_Click" Style="{StaticResource Win11SecondaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                        </StackPanel>
                        <controls:TaskProgressFloat x:Name="FloatZXing" IsDraggable="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- PSD Plugin (Magick.NET) -->
                <Border Style="{StaticResource PluginCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_PSD_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource L_Settings_Plugins_PSD_Desc}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStatusPSD" Text="Checking..." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="BtnInstallPSD" Content="{DynamicResource L_Settings_Plugins_InstallReal}" Click="InstallPSD_Click" Style="{StaticResource Win11PrimaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                            <Button x:Name="BtnUninstallPSD" Content="{DynamicResource L_Settings_Plugins_Uninstall}" Click="UninstallPSD_Click" Style="{StaticResource Win11SecondaryButtonStyle}" Width="80" Height="32" Visibility="Collapsed"/>
                        </StackPanel>
                        <controls:TaskProgressFloat x:Name="FloatPSD" IsDraggable="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <Grid x:Name="RmbgModelSetting" Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="213"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Settings_Plugins_RmbgModel_Title}"/>
                        <TextBlock Text="{DynamicResource L_Settings_Plugins_RmbgModel_Desc}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ComboBox x:Name="ComboRmbgModel" Grid.Column="1"
                              Style="{StaticResource FluentComboBoxStyle}"
                              Height="30" Margin="0,2,30,0"
                              SelectionChanged="ComboRmbgModel_SelectionChanged">
                        <ComboBoxItem Content="rmbg-1.4" Tag="Rmbg14"/>
                        <ComboBoxItem Content="rmbg-2.0" Tag="Rmbg20"/>
                    </ComboBox>
                </Grid>

                <TextBlock x:Name="TxtRmbgLowEndWarning" 
                           Text="{DynamicResource L_Settings_Plugins_Rmbg20_LowEndWarning}"
                           Foreground="#E74C3C" 
                           FontSize="11" 
                           Margin="220,-5,30,10" 
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Grid x:Name="ModelDirSetting" Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="153"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Settings_Plugins_ModelDir_Title}"/>
                        <TextBlock Text="{DynamicResource L_Settings_Plugins_ModelDir_Desc}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBox x:Name="TxtAiModelSaveDir"
                             Grid.Column="1"
                             Style="{StaticResource FluentTextBoxStyle}"
                             Height="30" Margin="0,2,8,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="True"
                             
                             Text="{Binding Path=Current.AiModelDefaultSaveDir, Mode=OneWay, Source={x:Static local:SettingsManager.Instance}}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource Win11SecondaryButtonStyle}"
                            Width="30"
                            Height="30"
                            Margin="0,2,0,0"
                            
                            Click="BrowseAiModelSaveDir_Click">
                        <Path x:Name="Open_Folder_Image" Data="{DynamicResource Open_Folder_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    </Button>
                
                    <controls:TaskProgressFloat x:Name="FloatModelMigration"
                                                IsDraggable="False"
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Margin="0,8,0,0"/>
                </Grid>

                <TextBlock Text="{DynamicResource L_Settings_General_AiImage_Header}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Margin="0,10,0,10"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Grid x:Name="AiImageApiBaseUrlSetting" Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="213"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Settings_General_AiImage_ApiBaseUrl_Title}"/>
                        <TextBlock Text="{DynamicResource L_Settings_General_AiImage_ApiBaseUrl_Desc}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource FluentTextBoxStyle}"
                             Height="30" Margin="0,2,30,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding Path=Current.AiImageApiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static local:SettingsManager.Instance}}"/>
                </Grid>

                <Grid x:Name="AiImageApiKeySetting" Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="213"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Settings_General_AiImage_ApiKey_Title}"/>
                        <TextBlock Text="{DynamicResource L_Settings_General_AiImage_ApiKey_Desc}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource FluentTextBoxStyle}"
                             Height="30" Margin="0,2,30,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding Path=Current.AiImageApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static local:SettingsManager.Instance}}"/>
                </Grid>

                <Grid x:Name="AiImageModelSetting" Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="213"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L_Settings_General_AiImage_Model_Title}"/>
                        <TextBlock Text="{DynamicResource L_Settings_General_AiImage_Model_Desc}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource FluentTextBoxStyle}"
                             Height="30" Margin="0,2,30,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding Path=Current.AiImageModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Source={x:Static local:SettingsManager.Instance}}"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
