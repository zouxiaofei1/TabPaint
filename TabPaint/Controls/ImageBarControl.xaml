<UserControl x:Class="TabPaint.Controls.ImageBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             xmlns:local="clr-namespace:TabPaint.Controls"
             xmlns:controls="clr-namespace:TabPaint.Controls"
             xmlns:root="clr-namespace:TabPaint"
             xmlns:services="clr-namespace:TabPaint.Services"
             mc:Ignorable="d" 
             x:Name="RootControl"
             d:DesignHeight="100" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>

            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:BindingProxy x:Key="Proxy" Data="{Binding IsSingleTabMode, ElementName=RootControl}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="MainContainer"
            
        Background="{DynamicResource GlassBackgroundMediumBrush}"
        VerticalAlignment="Top"
        ClipToBounds="False"
        Tag="{Binding ElementName=RootControl}">
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource Win11ContextMenuStyle}"
             DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                <MenuItem Style="{StaticResource Win11MenuItemStyle}"
                  Header="{DynamicResource L_ImgBar_ToggleView}"
                  services:ShortcutService.ShortcutKey="View.ToggleMode"
                  Click="Internal_OnToggleViewModeClick">
                    <MenuItem.Icon>
                        <Path Data="M4,7 L10,1 L16,7 M4,11 L10,17 L16,11" 
                      Stroke="{DynamicResource IconFillBrush}" 
                      StrokeThickness="1"
                      Stretch="Uniform" Width="14" Height="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource L_Menu_QA_Save}"
                  Click="Internal_OnSaveAllClick">
                    <MenuItem.Icon>
                        <Path Data="{DynamicResource Save_Edit_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource Win11MenuItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="{DynamicResource L_ImgBar_ClearUnedited}"
                  Click="Internal_OnClearUneditedClick">
                    <MenuItem.Icon>
                        <Path Data="{DynamicResource Clear_Unedited_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource Win11MenuItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="{DynamicResource L_Menu_QA_DiscardAll}"
                  Foreground="{DynamicResource DangerBrush}"
                  Click="Internal_OnDiscardAllClick">
                    <MenuItem.Icon>
                        <Path Data="{DynamicResource Reset_Image}" Stretch="Uniform" Fill="{DynamicResource DangerBrush}" Width="16" Height="16"/>
                    </MenuItem.Icon>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource Win11MenuItemStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Height" Value="100"/>
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Visibility" Value="Visible"/>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsViewMode, ElementName=RootControl}" Value="True">
                        <Setter Property="Height" Value="5"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCompactMode, ElementName=RootControl}" Value="True">
                        <Setter Property="Height" Value="45"/>
                    </DataTrigger>

                    <!-- 3. 视图模式下的悬停逻辑 (可选，如果需要悬停弹出) -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding IsMouseCaptureWithin, RelativeSource={RelativeSource Self}}" Value="False"/>
                            <Condition Binding="{Binding IsViewMode, ElementName=RootControl}" Value="True"/>
                            <Condition Binding="{Binding IsPinned, ElementName=RootControl}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Height" Value="100"/>
                        <!-- 悬停时恢复高度 -->
                        <Setter Property="Opacity" Value="1"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
            <Grid x:Name="HitTestLayer"
          Background="Transparent"
          AllowDrop="True"
          Margin="0,-5,0,0"
          ClipToBounds="False"
          PreviewMouseLeftButtonDown="Internal_OnBackgroundMouseLeftButtonDown">

          
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>
            <local:FilePreviewPopup x:Name="FilePreview" />
            <Border Grid.Column="0"
        Margin="4,0,4,0"
        VerticalAlignment="Center"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,1,0"
        Padding="0,0,2,0">
                <StackPanel Orientation="Vertical" Width="28">
                    <StackPanel x:Name="EditToolsPanel">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactMode, ElementName=RootControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button services:ShortcutService.BaseToolTip="L_Menu_QA_Save" 
                                services:ShortcutService.ShortcutKey="File.Save"
                                Click="Internal_OnSaveAllClick" PreviewMouseDoubleClick="Internal_OnSaveAllDoubleClick" Padding ="2" Style="{StaticResource RoundedMenuButtonStyle}" Width="22" Height="22" >
                            <Path Data="{DynamicResource Save_Edit_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="14" Height="14"/>
                        </Button>
                        <Button ToolTip="{DynamicResource L_ImgBar_ClearUnedited}" Padding ="2" Style="{StaticResource RoundedMenuButtonStyle}" Width="22" Height="22"  >
                            <Path Data="{DynamicResource Clear_Unedited_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="14" Height="14"/>
                        </Button>
                        <Button ToolTip="{DynamicResource L_Menu_QA_DiscardAll}" Click="Internal_OnDiscardAllClick" Padding ="2" Style="{StaticResource RoundedMenuButtonStyle}" Width="22" Height="22" >
                            <Path Data="{DynamicResource Reset_Image}" Stretch="Uniform" Fill="{DynamicResource WarningBrush}" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                    <Button services:ShortcutService.BaseToolTip="L_ImgBar_ToggleView" 
                            services:ShortcutService.ShortcutKey="View.ToggleMode"
                            Click="Internal_OnToggleViewModeClick" Padding ="2" Style="{StaticResource RoundedMenuButtonStyle}" Width="22" Height="22">
                        <Path Data="M4,10 L10,4 L16,10 M4,14 L10,20 L16,14" 
          Stroke="{DynamicResource IconFillBrush}" 
          StrokeThickness="1.2"
          Stretch="Uniform" 
          Width="14" Height="14"/>
                    </Button>

                </StackPanel>
            </Border>
            <ScrollViewer FocusVisualStyle="{x:Null}" x:Name="FileTabsScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" 
                          PreviewMouseWheel="Internal_OnFileTabsWheelScroll" 
                          ScrollChanged="Internal_OnFileTabsScrollChanged" 
                          ManipulationBoundaryFeedback="Internal_ScrollViewer_ManipulationBoundaryFeedback">
                <StackPanel Orientation="Horizontal">
                    <Button Name="LeftAddBtn"
        Click="Internal_OnPrependTabClick"
        services:ShortcutService.BaseToolTip="L_ImgBar_NewTabLeft">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Win11AddButtonStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewMode, ElementName=RootControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompactMode, ElementName=RootControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ItemsControl x:Name="FileTabList" ItemsSource="{Binding FileTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" AllowDrop="True" Margin="0,0,0,0" ClipToBounds="False"
                                      Drop="Internal_OnFileTabDrop" 
                                      DragOver="Internal_OnFileTabReorderDragOver"
                                      DragLeave="Internal_OnFileTabDragLeave">

                                    <Button x:Name="TabButton" Margin="2" Padding="4" 
                                            Click="Internal_OnFileTabClick" 
                                            PreviewMouseDown="Internal_OnFileTabPreviewMouseDown" 
                                            PreviewMouseRightButtonDown="Internal_OnFileTabPreviewMouseRightButtonDown"
                                            PreviewMouseMove="Internal_OnFileTabPreviewMouseMove" 
                                                 MouseEnter="Internal_OnTabMouseEnter"
                                         MouseLeave="Internal_OnTabMouseLeave"
                                          Tag="{Binding}">

                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource Win11ContextMenuStyle}" >
                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}" Header="{DynamicResource L_Menu_Edit_Copy}" 
                                                          services:ShortcutService.ShortcutKey="Edit.Copy"
                                                          Click="Internal_OnTabCopyClick" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Copy_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                              

                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}" Header="{DynamicResource L_Menu_Edit_Paste}" 
                                                          services:ShortcutService.ShortcutKey="Edit.Paste"
                                                          Click="Internal_OnTabPasteClick" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Paste_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}" Header="{DynamicResource L_Menu_File_OpenTabFolder}" 
                                                          services:ShortcutService.ShortcutKey="File.OpenWorkspace"
                                                          Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}"
                                                          Click="Internal_OnTabOpenFolderClick" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Open_Folder_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}" Header="{DynamicResource L_Ctx_Rename}" 
                                                          Click="Internal_OnTabRenameClick" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Rename_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}" Header="{DynamicResource L_Ctx_StickImage}" 
          Click="Internal_OnTabStickImageClick" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Open_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}"
                                                          Header="{DynamicResource L_Common_Close}"
                                                          Click="Internal_OnTabDeleteClick"
                                                          Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource NewFile_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                      
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource L_Ctx_CloseOtherTabs}"
                                                          Click="Internal_OnTabCloseOthersClick"
                                                          Tag="{Binding}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource Win11MenuItemStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Data, Source={StaticResource Proxy}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource New_Window_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <MenuItem Header="{DynamicResource L_Menu_Tab_MoveToNewWindow}"
                                                          Click="Internal_OnTabMoveToNewWindowClick"
                                                          Tag="{Binding}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource Win11MenuItemStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Data, Source={StaticResource Proxy}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource New_Window_Image}" Fill="{DynamicResource IconFillBrush}" Stretch="Uniform" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}"
                                                          Header="{DynamicResource L_Menu_Tab_NewTabRight}"
                                                          Click="Internal_OnTabNewTabRightClick"
                                                          Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Attachright_Image}" Fill="{DynamicResource IconFillBrush}" Stretch="Uniform" Width="14" Height="14" />
                                                    </MenuItem.Icon>
                                                </MenuItem>

                                                <MenuItem Style="{StaticResource Win11MenuItemStyle}" Header="{DynamicResource L_Ctx_DeleteFile}" 
                             Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVis}}"
                             Click="Internal_OnTabFileDeleteClick" Foreground="Red" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <Path Data="{DynamicResource Delete_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>

                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid x:Name="ContentGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 图片 -->
                                            <Image x:Name="ThumbImage" Grid.Row="0" Source="{Binding Thumbnail}" Width="100" Height="60" Stretch="Uniform" VerticalAlignment="Center"/>

                                            <!-- 文字 -->
                                            <TextBlock x:Name="TabLabel" Grid.Row="1" Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

                                            <Ellipse x:Name="DirtyDot" 
                                                 Width="8" Height="8" 
                                                 HorizontalAlignment="Left" 
                                                 VerticalAlignment="Top" 
                                                 Margin="0,0,0,0" 
                                                 IsHitTestVisible="False"
                                                 Fill="{DynamicResource DangerBrush}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Button x:Name="CloseBtn" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-6,0" 
                                                    Background="{DynamicResource GlassBackgroundHighBrush}" Style="{StaticResource OtherCloseButtonStyle}" BorderThickness="0" 
                                                    Click="Internal_OnFileTabCloseClick" Tag="{Binding}" Visibility="Hidden" Grid.RowSpan="2">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="9"/>
                                                    </Style>
                                                </Button.Resources>
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M0,0 L8,8 M8,0 L0,8" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Width" Value="{Binding CurrentTabWidth, ElementName=RootControl}"/>
                                                <Setter Property="Height" Value="80"/>
                                                <Setter Property="ToolTip" Value="{Binding FileName}"/>
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="IsHitTestVisible" Value="True"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsDragSourceHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ListItemSelectedBorderBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompactMode, ElementName=RootControl}" Value="True">
                                                        <Setter Property="ToolTip" Value="{x:Null}"/>
                                                        <Setter Property="Height" Value="32"/>
                                                        <Setter Property="Padding" Value="8,0,8,0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border x:Name="InsertLine" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" 
                                            Background="{DynamicResource ToolAccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" Margin="0,6,0,6" Padding="0,0,2,0" CornerRadius="2" Opacity="0.95"/>

                                </Grid>

                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                                    </Trigger>

                                    <DataTrigger Binding="{Binding Path=Current.AlwaysShowTabCloseButton, Source={x:Static root:SettingsManager.Instance}}" Value="True">
                                        <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompactMode, ElementName=RootControl}" Value="True">
                                        <Setter TargetName="ThumbImage" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="TabLabel" Property="Grid.Row" Value="0"/>
                                        <Setter TargetName="TabLabel" Property="Grid.RowSpan" Value="2"/>
                                        <Setter TargetName="TabLabel" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="TabLabel" Property="TextAlignment" Value="Left"/>
                                        <Setter TargetName="TabLabel" Property="Margin" Value="14,0,20,0"/>
                                        <Setter TargetName="TabLabel" Property="VerticalAlignment" Value="Center"/>
                                        <Setter TargetName="DirtyDot" Property="Margin" Value="2,0,0,0"/>
                                        <Setter TargetName="DirtyDot" Property="VerticalAlignment" Value="Center"/>
                                        <Setter TargetName="CloseBtn" Property="VerticalAlignment" Value="Center"/>
                                        <Setter TargetName="CloseBtn" Property="Margin" Value="0,0,2,0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 新建按钮 -->
                    <Button x:Name="NewTabBtn"
        Click="Internal_OnNewTabClick"
        services:ShortcutService.BaseToolTip="L_Menu_QA_NewTab"
        services:ShortcutService.ShortcutKey="File.NewTab">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Win11AddButtonStyle}">
                                <Setter Property="Height" Value="80"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewMode, ElementName=RootControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompactMode, ElementName=RootControl}" Value="True">
                                        <Setter Property="Height" Value="32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. 预览滑块 -->
            <Slider Grid.Column="2" x:Name="PreviewSlider" Orientation="Vertical" Minimum="0" Maximum="100" Width="24" Margin="0,4,4,4" IsDirectionReversed="True" IsMoveToPointEnabled="True" 
                    ValueChanged="Internal_PreviewSlider_ValueChanged"  
                    PreviewMouseWheel="Internal_Slider_PreviewMouseWheel"> 
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" x:Name="RootGrid">
                            <Border Width="4" CornerRadius="2" Background="{DynamicResource TextControlBrush}" Opacity="0.1" HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="PART_Thumb" Height="16" Width="16" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#33000000" Margin="0,2,-1,-2"/>
                                                    <Ellipse x:Name="ThumbDot" Fill="{DynamicResource ToolAccentBrush}" Stroke="{DynamicResource TextInverseBrush}" StrokeThickness="2"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbDot" Value="{DynamicResource TextDisabledBrush}" Property="Fill" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Slider.Template>
                <Slider.Resources>
                    <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
                        <Setter Property="OverridesDefaultStyle" Value="true"/>
                        <Setter Property="IsTabStop" Value="false"/>
                        <Setter Property="Focusable" Value="false"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Slider.Resources>
            </Slider>


        </Grid>
    </Border>
</UserControl>
