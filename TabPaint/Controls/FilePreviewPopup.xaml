<UserControl x:Class="TabPaint.Controls.FilePreviewPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="250">
    <Grid>
        <Popup x:Name="LargePreviewPopup" 
               Placement="Right" 
               AllowsTransparency="True" 
               StaysOpen="True" 
               IsHitTestVisible="False" 
               VerticalOffset="0" 
               HorizontalOffset="10"
               PopupAnimation="Fade">

            <Border Background="{DynamicResource GlassBackgroundHighBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="6" 
                    Margin="10"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.4" Direction="270"/>
                </Border.Effect>

                <StackPanel Orientation="Vertical">
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Border x:Name="CheckerboardBorder" Background="Transparent">
                            <Grid>
                                <Image x:Name="PopupPreviewImageBase" 
                                       MaxHeight="150" MaxWidth="250" Stretch="Uniform"
                                       IsHitTestVisible="False"/>
                                <Image x:Name="PopupPreviewImage" 
                                       gif:AnimationBehavior.AutoStart="True"
                                       gif:AnimationBehavior.RepeatBehavior="Forever"
                                       MaxHeight="150" MaxWidth="250" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                    </Border>
                    <!-- 信息区 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="FileInfoPanel" Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Path Data="{DynamicResource Picture_Image}"
                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                  Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" Opacity="0.7"/>
                            <TextBlock x:Name="PopupDimensionsText" 
                                       Text="Loading..." 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="PopupFileSizeText" 
                                   Grid.Column="1" 
                                   Text="" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="8,0,0,0"/>
                        <TextBlock x:Name="FilterNameText" 
                                   Grid.Column="0" Grid.ColumnSpan="2"
                                   Visibility="Collapsed"
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
