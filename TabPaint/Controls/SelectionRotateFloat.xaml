<UserControl x:Class="TabPaint.Controls.SelectionRotateFloat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TabPaint.Controls"
             mc:Ignorable="d"
             d:DesignHeight="56" d:DesignWidth="280"
             Visibility="Collapsed"
             MouseDown="UserControl_MouseDown">

    <Border CornerRadius="8" 
            Background="{DynamicResource PanelBackgroundBrush}" 
            BorderBrush="{DynamicResource BorderMediumBrush}" 
            BorderThickness="1"
            Width="280"
            Padding="12,4"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="RotateAngleText"
                       Text="0°"
                       FontSize="11"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,3"
                       IsHitTestVisible="False"/>

            <Border Grid.Row="1"
                    x:Name="RotateBarBorder"
                    Height="24"
                    Margin="0"
                    VerticalAlignment="Center"
                    CornerRadius="4"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True"
                    MouseDown="RotateBar_MouseDown"
                    MouseMove="RotateBar_MouseMove"
                    MouseUp="RotateBar_MouseUp"
                    MouseLeave="RotateBar_MouseLeave"
                    PreviewMouseLeftButtonDown="RotateBar_PreviewMouseLeftButtonDown">
                <Grid>
                    <Canvas x:Name="RotateTickCanvas"
                            ClipToBounds="True"
                            Margin="4,2"/>

                    <Border Width="1"
                            HorizontalAlignment="Center"
                            Margin="0,2"
                            Background="{DynamicResource AccentBrush}"
                            IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
