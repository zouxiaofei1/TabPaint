<UserControl x:Class="TabPaint.Controls.QuickFormatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <!-- 半透明背景遮罩 -->
        <Border Background="#40000000" MouseDown="Background_MouseDown"/>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- 标题和提示 -->
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                    CornerRadius="8" Padding="20" Margin="0,0,0,20"
                    BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    Effect="{DynamicResource DropShadowEffect}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L_QuickFormat_Title}" 
                               FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource L_QuickFormat_Tip}" 
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 圆形选择面板 -->
            <Grid Width="260" Height="260">
                <!-- 圆环背景 -->
                <Ellipse Stroke="{DynamicResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="2" Margin="2"/>
                <Ellipse Stroke="{DynamicResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="2" Margin="60"/>

                <!-- 五个选项 -->
                <Canvas x:Name="ItemsCanvas" Width="260" Height="260">
                    <!-- 扇区将在后台代码中动态生成并应用样式 -->
                </Canvas>
                
                <!-- 中心空心部分 -->
                <Ellipse Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}" Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path Data="M 130,80 L 130,180 M 80,130 L 180,130" Stroke="{DynamicResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.3"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
