<UserControl x:Class="TabPaint.Controls.TitleBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TabPaint.Controls"
             xmlns:root="clr-namespace:TabPaint"
             xmlns:services="clr-namespace:TabPaint.Services"
             PreviewMouseDoubleClick="Window_DoubleClick"
             mc:Ignorable="d" 
             d:DesignHeight="34" d:DesignWidth="800">

    <Border x:Name="TitleBarBorder" VerticalAlignment="Top" HorizontalAlignment="Stretch" 
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" AllowDrop="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="{DynamicResource GlassBackgroundLowBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=Current.UseNewStyle, Source={x:Static root:SettingsManager.Instance}}" Value="True">
                        <Setter Property="Height" Value="34"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:FilePreviewPopup x:Name="FilePreview" />
            <Image Grid.Column="0" x:Name="AppIcon" Width="20" Height="20" Margin="8,0,8,0"
                   PreviewMouseMove="OnAppIconPreviewMouseMove"
                   PreviewMouseLeftButtonDown="OnAppIconPreviewMouseDown"
                   PreviewMouseLeftButtonUp="OnAppIconPreviewMouseLeftButtonUp"
                   MouseDown="OnAppIconMouseDown"/>

            <!-- 新版界面元素容器 -->
            <StackPanel Grid.Column="1" x:Name="NewStylePanel" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=Current.UseNewStyle, Source={x:Static root:SettingsManager.Instance}}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- ====== 汉堡菜单按钮（窄窗口时显示） ====== -->
                <Button x:Name="HamburgerButton" 
                        Width="34" Height="30" 
                        Click="OnHamburgerClick"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Visibility="Collapsed"
                        ToolTip="{DynamicResource L_Menu_File}">
                    <Path Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18" 
                          Stroke="{DynamicResource IconFillBrush}" 
                          StrokeThickness="1.5" 
                          Stretch="Uniform" 
                          Width="16" Height="14"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="HamburgerContextMenu" 
                                     Style="{StaticResource Win11ContextMenuStyle}"
                                     Opened="OnHamburgerMenuOpened">
                            <MenuItem x:Name="HamburgerFileMenu"
                                      Header="{DynamicResource L_Menu_File}" 
                                      Style="{StaticResource Win11MenuItemStyle}">
                                <MenuItem Visibility="Collapsed"/>
                            </MenuItem>
                            <MenuItem x:Name="HamburgerEditMenu"
                                      Header="{DynamicResource L_Menu_Edit}" 
                                      Style="{StaticResource Win11MenuItemStyle}">
                                <MenuItem Visibility="Collapsed"/>
                            </MenuItem>
                            <MenuItem x:Name="HamburgerEffectMenu"
                                      Header="{DynamicResource L_Menu_Effect}" 
                                      Style="{StaticResource Win11MenuItemStyle}">
                                <MenuItem Visibility="Collapsed"/>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Menu x:Name="MainMenuBar" Background="Transparent" BorderThickness="0" FontSize="14" Padding="0" Margin="0" VerticalAlignment="Center">
                    <MenuItem Header="{DynamicResource L_Menu_File}" 
                              Style="{StaticResource ModernMenuItemStyle}" 
                              Height="34"
                              SubmenuOpened="OnFileMenuOpened">
                        <MenuItem Visibility="Collapsed"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource L_Menu_Edit}" 
                              Style="{StaticResource ModernMenuItemStyle}"
                              Height="34"
                              SubmenuOpened="OnEditMenuOpened">
                        <MenuItem Visibility="Collapsed"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource L_Menu_Effect}" 
                              Style="{StaticResource ModernMenuItemStyle}"
                              Height="34"
                              SubmenuOpened="OnEffectMenuOpened">
                        <MenuItem Visibility="Collapsed"/>
                    </MenuItem>
                </Menu>

                <Border Width="1" Height="14" Background="{DynamicResource BorderMediumBrush}" Margin="4,0"/>

                <!-- ====== 第1组：保存按钮 (< 700px 隐藏) ====== -->
                <StackPanel x:Name="ToolbarGroup_Save" Orientation="Horizontal">
                    <Button Width="40" Height="34" Margin="2,0" 
                            services:ShortcutService.BaseToolTip="L_Menu_QA_Save" 
                            services:ShortcutService.ShortcutKey="File.Save" 
                            Click="OnSaveClick" Style="{StaticResource TitleBarButtonStyle}">
                        <Path Data="{DynamicResource Save_Normal_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <!-- ====== 第2组：撤销/重做 (< 750px 隐藏) ====== -->
                <StackPanel x:Name="ToolbarGroup_UndoRedo" Orientation="Horizontal">
                    <Button Width="40" Height="34" Margin="2,0"
                            services:ShortcutService.BaseToolTip="L_Menu_QA_Undo" 
                            services:ShortcutService.ShortcutKey="Edit.Undo" 
                            x:Name="UndoButton" Click="OnUndoClick" IsEnabled="False" 
                            Style="{StaticResource TitleBarButtonStyle}">
                        <Path x:Name="UndoIcon" Data="{DynamicResource Undo_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    </Button>
                    <Button Width="40" Height="34" Margin="2,0"
                            services:ShortcutService.BaseToolTip="L_Menu_QA_Redo" 
                            services:ShortcutService.ShortcutKey="Edit.Redo" 
                            x:Name="RedoButton" Click="OnRedoClick" IsEnabled="False" 
                            Style="{StaticResource TitleBarButtonStyle}">
                        <Path x:Name="RedoIcon" Data="{DynamicResource Redo_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <!-- ====== 分隔符（跟随 NewTab/Discard 组一起隐藏） ====== -->
                <Border x:Name="ToolbarSeparator_BeforeNewTab" Width="1" Height="14" Background="{DynamicResource BorderMediumBrush}" Margin="4,0"/>

                <!-- ====== 第3组：新标签 + 放弃图片更改 (< 850px 隐藏) ====== -->
                <StackPanel x:Name="ToolbarGroup_Discard" Orientation="Horizontal">
                    <Button Width="28" Height="34" Margin="2,0"
                            services:ShortcutService.BaseToolTip="L_Menu_QA_NewTab" 
                            services:ShortcutService.ShortcutKey="File.NewTab" 
                            x:Name="NewTabButton" Click="OnNewTabClick" 
                            Style="{StaticResource TitleBarButtonStyle}">
                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="14" Height="14"/>
                    </Button>
                    <Button Width="28" Height="34" Margin="2,0"
                            ToolTip="{DynamicResource L_Menu_QA_DiscardImage}"
                            Click="OnDiscardImageClick" Style="{StaticResource TitleBarButtonStyle}">
                        <Path Data="{DynamicResource Reset_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource Win11ContextMenuStyle}">
                                <MenuItem Header="{DynamicResource L_Menu_QA_DiscardAll}"
                                          Foreground="{DynamicResource DangerBrush}"
                                          Style="{StaticResource Win11MenuItemStyle}"
                                          Click="OnDiscardAllClick">
                                    <MenuItem.Icon>
                                        <Path Data="{DynamicResource Reset_Image}" Stretch="Uniform" Fill="{DynamicResource WarningBrush}" Width="14" Height="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- ====== 尾部分隔符 ====== -->
                <Border x:Name="ToolbarSeparator_End" Width="1" Height="14" Background="{DynamicResource BorderMediumBrush}" Margin="4,0"/>

                <!-- 占位：保持 CollapsibleToolbar 引用不报错 -->
                <StackPanel x:Name="CollapsibleToolbar" Orientation="Horizontal" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock Grid.Column="2" 
                       x:Name="TitleTextBlock" 
                       Text="TabPaint" 
                       VerticalAlignment="Center" 
                       FontSize="12" 
                       Style="{StaticResource TitleTextStyle}"
                       TextTrimming="CharacterEllipsis" 
                       TextWrapping="NoWrap"
                       ToolTip="{Binding WorkingDirectory, RelativeSource={RelativeSource AncestorType=local:TitleBarControl}}"
                       MouseRightButtonUp="OnTitleTextBlockRightClick"
                       Margin="10,0,10,0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                <Popup x:Name="LogoMenuHintPopup"
                       PlacementTarget="{Binding ElementName=AppIcon}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       VerticalOffset="6"
                       StaysOpen="False"
                       HorizontalOffset="0">
                    <Grid Margin="10">
                        <Path Data="M 0,8 L 8,0 L 16,8 Z" Fill="{DynamicResource SystemAccentColorLightBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0"/>
                        <Border Background="{DynamicResource GlassBackgroundBrush}"
                                BorderBrush="{DynamicResource SystemAccentColorLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,7,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource L_Hint_ClickLogoMenu}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                                <Button Click="CloseLogoMenuHint_Click"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="12,0,-4,0"
                                        Padding="0"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Path Data="M0,0 L8,8 M8,0 L0,8"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.2"
                                          Width="8" Height="8"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>

                <Button Width="40" Height="30" Margin="0,0"
                        ToolTip="{DynamicResource L_Menu_QA_Settings}" 
                        Click="OnSettingsClick">
                    <Path Data="{DynamicResource Settings_Image}" Stretch="Uniform" 
                          Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Current.UseNewStyle, 
                                             Source={x:Static root:SettingsManager.Instance}}" 
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 帮助按钮 (< 500px 隐藏) -->
                <Button Width="40" Height="30" x:Name="HelpButton"
                        ToolTip="{DynamicResource L_TitleBar_Help}"
                        Click="OnHelpClick"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Margin="0,0,4,0">
                    <Path Data="{DynamicResource Help_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                </Button>

                <Popup x:Name="HelpHintPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="2" StaysOpen="False" HorizontalOffset="-80">
                    <Grid Margin="10">
                        <Path Data="M 0,8 L 8,0 L 16,8 Z" Fill="{DynamicResource SystemAccentColorLightBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,91,0"/>
                        <Border Background="{DynamicResource GlassBackgroundBrush}" 
                                BorderBrush="{DynamicResource SystemAccentColorLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="12,8" 
                                Margin="0,7,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2" Color="Black"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource L_Hint_ClickHelp}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           FontSize="13" 
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                                <Button Click="CloseHelpHint_Click" 
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Width="24" Height="24"
                                        Margin="12,0,-4,0"
                                        Padding="0"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Path Data="M0,0 L8,8 M8,0 L0,8" 
                                          Stroke="{DynamicResource TextSecondaryBrush}" 
                                          StrokeThickness="1.2" 
                                          Width="8" Height="8" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>

                <Button Width="40" Height="30" x:Name="ModeSwitchButton" 
                        services:ShortcutService.BaseToolTip="L_TitleBar_ToggleMode" 
                        services:ShortcutService.ShortcutKey="View.ToggleMode" 
                        Click="OnModeSwitchClick" 
                        Style="{StaticResource TitleBarButtonStyle}"
                        Margin="0,0,8,0">
                    <Path x:Name="ModeIconImage" Data="{DynamicResource View_Mode_Image}" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Width="16" Height="16"/>
                </Button>

                <Button Width="40" Height="30" ToolTip="{DynamicResource L_TitleBar_Minimize}" Click="OnMinimizeClick" Style="{StaticResource TitleBarButtonStyle}">
                    <Viewbox Width="10" Height="10">
                        <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Data="M0,2 L12,2"/>
                    </Viewbox>
                </Button>
                <Button Width="40" Height="30" Name="MaxRestoreButton" ToolTip="{DynamicResource L_TitleBar_Maximize}" Click="OnMaximizeRestoreClick" Style="{StaticResource TitleBarButtonStyle}">
                    <Viewbox Width="10" Height="10">
                        <Rectangle Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1" Width="12" Height="12" RadiusX="2" RadiusY="2"/>
                    </Viewbox>
                </Button>
                <Button Width="48" Height="30" ToolTip="{DynamicResource L_TitleBar_Close}" Click="OnCloseClick" Style="{StaticResource CloseButtonStyle}">
                    <Viewbox Width="10" Height="10">
                        <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              StrokeThickness="1" 
                              Data="M0,0 L12,12 M12,0 L0,12"/>
                    </Viewbox>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
